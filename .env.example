# Optional runtime overrides. Normal local configuration belongs in
# config.yaml; these values take precedence when present.
# Rider Tracker local server
# PORT=8787
# HOST=127.0.0.1

# Embedded Training Agent API. `npm start` launches it automatically. The token
# remains in the Node process and is never returned to browser JavaScript.
# PERSONAL_FIT_AGENT_URL=http://127.0.0.1:8000
# PERSONAL_FIT_AGENT_TOKEN=
# Optional Python executable override. By default the launcher prefers
# services/training-agent/.venv and then python3/python.
# PYTHON_EXECUTABLE=/absolute/path/to/python
# PERSONAL_FIT_AGENT_HOST=127.0.0.1
# PERSONAL_FIT_AGENT_PORT=8000

# Optional Strava integration
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
