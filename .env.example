# Rider Tracker local server
PORT=8787
HOST=127.0.0.1

# Personal FIT Agent local API. The token remains in the Node process and is
# never returned to browser JavaScript.
PERSONAL_FIT_AGENT_URL=http://127.0.0.1:8000
PERSONAL_FIT_AGENT_TOKEN=

# Optional Strava integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
