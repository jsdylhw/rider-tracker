# Web 服务 Key：仅由本地 Python 服务读取，用于骑行路径规划与 POI 搜索。
AMAP_WEB_SERVICE_KEY=replace-with-web-service-key

# JS API Key：浏览器加载高德底图时使用。请在高德控制台限制 Referer。
AMAP_JS_KEY=replace-with-js-api-key

# 2021-12-02 后创建的 JS Key 通常需要此安全密钥。
# 此 Demo 为本地验证，采用高德允许的浏览器直配方式；生产环境应改为
# 官方文档推荐的 serviceHost 反向代理，避免把 securityJsCode 暴露给浏览器。
AMAP_SECURITY_JS_CODE=replace-with-security-js-code

# 可选：已有 OSM Demo 的 WGS-84 探针目录。服务会在读取时转换成 GCJ-02，
# 因而可以叠加到高德底图。默认不需要设置。
# ROUTE_PROBE_DIR=../osm_cycling_router/data/route-probes
